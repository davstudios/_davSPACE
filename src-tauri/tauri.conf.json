{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "_davSPACE",
  "version": "1.0.1",
  "identifier": "studio.dav.space",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:17460",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "_davSPACE",
        "width": 1420,
        "height": 880,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Local disk space analyzer",
    "longDescription": "_davSPACE analyzes disk and folder usage locally, showing largest files, folders and categories without modifying your data.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
